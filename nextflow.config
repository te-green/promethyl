// promethyl cohort pipeline — Nextflow config

conda.enabled = true

// Points at a pre-built conda env by name/path, defaulting to envs/promethyl under
// PROMETHYL_HOME (or projectDir if that's not set) — e.g. a shared install built once
// with `conda env create -f promethyl_environment.yml -p $PROMETHYL_HOME/envs/promethyl`.
// Override with --conda_env to point elsewhere (e.g. --conda_env promethyl_environment.yml
// to solve the env on the fly instead of using a pre-built one).
params.conda_env = "${System.getenv('PROMETHYL_HOME') ?: projectDir}/envs/promethyl"

// REPORT gets its own small, separate env (pandas/jinja2/requests only) rather than
// sharing params.conda_env with every other process. Every process shares one `conda`
// directive value, and Nextflow's task cache hash includes that value directly -- so
// any future change to reporting deps (e.g. adding a plotting library) would otherwise
// invalidate the cache for CHECK_MM_TAGS/FIX_MM_TAGS/MODKIT/COHORT too, forcing a full
// 155-sample rerun for an unrelated Python package (this is what just happened when
// jinja2/requests were installed into the shared env directly). Build once with:
//   mamba env create -f promethyl_report_environment.yml -p $PROMETHYL_HOME/envs/report
params.report_conda_env = "${System.getenv('PROMETHYL_HOME') ?: projectDir}/envs/report"

process {
    conda = params.conda_env

    withName: CHECK_MM_TAGS {
        cpus   = 1
        memory = 1.GB
        queue  = 'prod_short'
        time   = 10.m
    }
    withName: FIX_MM_TAGS {
        cpus   = 4
        // Scale memory (and therefore samtools sort's per-thread -m, computed from
        // task.memory in the script) and wall time together on retry. RDN0417 hit exit
        // 140 -- confirmed via sacct as TIMEOUT, not OOM -- because it fell back to
        // samtools' slower on-disk+in-memory merge sort and then ran past the 4h limit.
        // More per-thread memory makes the in-memory-only sort path more likely (faster),
        // and more wall time is a backstop if a sample still needs the slow path anyway.
        memory = { 32.GB * task.attempt }
        queue  = 'prod_med'
        time   = { 4.h * task.attempt }
        errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
        maxRetries    = 2
    }
    withName: MODKIT {
        cpus   = { params.threads }
        memory = 4.GB
        queue  = 'prod_short'
        time   = 1.h
    }
    withName: COHORT {
        cpus   = 1
        memory = 32.GB
        queue  = 'prod_short'
        time   = 2.h
    }
    withName: REPORT {
        conda  = params.report_conda_env
        cpus   = 1
        memory = 2.GB
        queue  = 'prod_short'
        // Generous: a cold/unseeded panelapp_cache means one live API call per new gene
        // symbol (~3 req/s throttle in panelapp.py). Seed params.samples' panelapp_cache
        // from a previous run's published cache to keep this fast, and confirm prod_short
        // nodes actually have outbound internet -- if not, this will hang/fail and the
        // cache needs pre-populating from a login node instead.
        time   = 1.h
    }
}

env {
    PYTHONPATH = "${projectDir}/src"
}

profiles {
    standard {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
        process.queue    = 'prod_short'
    }
}

report {
    enabled   = true
    file      = 'report.html'
    overwrite = true
}

// scripts in src/ are invoked directly on PATH in main.nf (e.g. run_sample.py);
// this puts src/ on PATH for every process so those calls resolve.
process.beforeScript = "export PATH=\"${projectDir}/src:\$PATH\""
